# Application metadata and runtime settings
APP_NAME=Genesis
APP_VERSION=0.1.0
APP_DESCRIPTION="An extensible Agent Operating System for autonomous AI applications."
# Informational only; it doesn't change behavior.
ENVIRONMENT=development
# Exact browser origins allowed to call the API and to make state-changing requests
# (JSON list). The default covers the console on localhost/127.0.0.1, ports 3000 and 3001
# (Next.js's fallback). To serve the console elsewhere, list every origin you need, e.g.:
# CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]
# Host headers the backend answers (any port). Keep these loopback-only.
# TRUSTED_HOSTS=["localhost","127.0.0.1","[::1]"]
# The listen address comes from the uvicorn command (127.0.0.1 by default), not from this
# file: never start the backend with --host 0.0.0.0 (Genesis has no authentication).
LOG_LEVEL=INFO
EVENT_HISTORY_SIZE=1000
HEARTBEAT_INTERVAL_SECONDS=30

# Persistence (Agents and conversations). Run `alembic upgrade head` after changing it.
# PostgreSQL (supported engine):
DATABASE_URL=postgresql+asyncpg://localhost:5432/genesis
# Zero-setup local alternative:
# DATABASE_URL=sqlite+aiosqlite:///./genesis.db

# Durable work: how long a worker's claim lasts without renewal (seconds), and how many
# executions / workflow runs one process works on at once.
WORKER_LEASE_SECONDS=30
WORKER_CONCURRENCY=4

# Most recent complete conversation turns sent to the model with each message.
AGENT_CONTEXT_MAX_TURNS=20

# How long an approval request stays valid (pending, or approved but not yet used), seconds.
APPROVAL_TTL_SECONDS=3600

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=30

# Accepted but unused: Genesis has no Anthropic provider yet.
ANTHROPIC_API_KEY=
