# Application metadata and runtime settings
APP_NAME=Genesis
APP_VERSION=0.1.0
APP_DESCRIPTION="An extensible Agent Operating System for autonomous AI applications."
ENVIRONMENT=development
# Browser origins allowed to call the API (JSON list). In development, any
# localhost/127.0.0.1 port is also accepted so Next.js can fall back to 3001.
# CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
EVENT_HISTORY_SIZE=1000
HEARTBEAT_INTERVAL_SECONDS=30

# Persistence (Agents and conversations). Run `alembic upgrade head` after changing it.
# PostgreSQL (supported engine):
DATABASE_URL=postgresql+asyncpg://localhost:5432/genesis
# Zero-setup local alternative:
# DATABASE_URL=sqlite+aiosqlite:///./genesis.db

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=30

ANTHROPIC_API_KEY=
